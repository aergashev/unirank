# Postgres. docker compose publishes the dev database on 127.0.0.1:5439.
DATABASE_URL=postgresql://unirank:change-me@127.0.0.1:5439/unirank
POSTGRES_PASSWORD=change-me

# Signs the admin session cookie. `openssl rand -hex 32`
SESSION_SECRET=

# Absolute origin, used for gateway return URLs and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3300

# Which payment provider handles checkout. Only `test` exists today — a
# built-in sandbox gateway. Real providers register in lib/payments/index.ts.
PAYMENT_PROVIDER=test
# Signs the sandbox gateway's callbacks. `openssl rand -hex 24`
TEST_GATEWAY_SECRET=

# First admin account, created by `npm run db:seed` if it does not exist.
ADMIN_EMAIL=admin@unirank.uz
ADMIN_PASSWORD=
